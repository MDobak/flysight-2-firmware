<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The accent colour tints the platform widgets (text cursor, seek bar, popup menu). -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <!-- Each screen draws its own top bar. -->
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">@android:color/system_accent1_600</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
